# syntax=docker/dockerfile:1

FROM oven/bun:1.3.14-alpine AS build
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src
RUN bun build ./src/server/sync/worker-cli.ts \
  --target=bun \
  --conditions=react-server \
  --outfile=./dist/sync-worker.js

FROM oven/bun:1.3.14-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY --from=build --chown=bun:bun /app/dist/sync-worker.js ./sync-worker.js

USER bun
CMD ["bun", "--smol", "./sync-worker.js"]
